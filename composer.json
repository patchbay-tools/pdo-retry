{
    "name": "jhalvorsen/pdo-retry",
    "description": "Retry wrapper for PDO on deadlocks and lost connections",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdo", "retry", "deadlock", "mysql", "postgresql"],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Halvorsen\\PdoRetry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Halvorsen\\PdoRetry\\Tests\\": "tests/"
        }
    }
}
